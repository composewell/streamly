-- Build with GHC's JavaScript backend. Run inside the "nix develop .#js"
-- shell, which provides javascript-unknown-ghcjs-ghc with the non-boot
-- dependencies of streamly-core, streamly and streamly-tests installed.

packages: core/streamly-core.cabal
        , streamly.cabal
        , bench-test-lib/bench-test-lib.cabal
        , test/streamly-tests.cabal

tests: True

-- Cap GHC heap usage so that builds do not exhaust the machine memory
flags: +limit-build-mem
jobs: 1

-- ghcjs-ghc is bin/ghcjs-ghc, which calls javascript-unknown-ghcjs-ghc, see
-- the script for why. The js nix shell and the JS CI put it in PATH.
with-compiler: ghcjs-ghc
with-hc-pkg: javascript-unknown-ghcjs-ghc-pkg

package *
  hsc2hs-location: javascript-unknown-ghcjs-hsc2hs

-- The JS backend needs more than the 500M that limit-build-mem sets for
-- streamly-core, the build peaks at about 1.6GB in use. A later -M
-- overrides the earlier one.
package streamly-core
  ghc-options: +RTS -M2000M -RTS

package streamly
  ghc-options: +RTS -M2000M -RTS

package streamly-tests
  ghc-options: +RTS -M3000M -RTS
