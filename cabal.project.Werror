packages:
  ./
  benchmark
  test
  core
  bench-test-lib

-- Cap GHC heap usage so that builds do not exhaust the machine memory
flags: +limit-build-mem

-- For debugging heap overflow
-- jobs: 1

package streamly
  ghc-options: -Werror

package streamly-core
  ghc-options: -Werror

package streamly-benchmarks
  ghc-options: -Werror

package streamly-tests
  ghc-options: -Werror
