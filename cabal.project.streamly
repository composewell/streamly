packages:   streamly.cabal
          , test/streamly-tests.cabal
          , benchmark/streamly-benchmarks.cabal
          , bench-test-lib/bench-test-lib.cabal

-- Cap GHC heap usage so that builds do not exhaust the machine memory
flags: +limit-build-mem

source-repository-package
  type: git
  location: https://github.com/composewell/streamly
  tag: master
  subdir: core

-- streamly-core is not a local package here, top level flags do not apply
package streamly-core
  flags: +limit-build-mem
