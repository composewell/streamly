packages:
  ./
  test
  benchmark
  core
  bench-test-lib

-- Cap GHC heap usage so that builds do not exhaust the machine memory
flags: +limit-build-mem

-- Keep the flags same as cabal.project.doctest because we utilize the
-- same build for doctests in CI.

package streamly
  flags: -opt
  ghc-options: -O0

package streamly-core
  flags: -opt
  ghc-options: -O0

package streamly-tests
  flags: -opt
  ghc-options: -O0

package streamly-benchmarks
  flags: -opt
  ghc-options: -O0
